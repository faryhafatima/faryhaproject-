```html
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Website</title>

    <link rel="stylesheet" href="/static/style.css">
</head>

<body>

    <!-- Header -->
    <header>

        <h1>My Website</h1>

        <p>Frontend + Backend + Database</p>

        <nav>
            <a href="/">Home</a>
            <a href="#about">About</a>
            <a href="#users">Users</a>
        </nav>

    </header>


    <!-- Main Content -->
    <main>

        <!-- Welcome Section -->
        <section>

            <h2>Welcome to My Website</h2>

            <p>
                This website is connected to a Flask backend
                and SQLite database.
            </p>

            <button onclick="getMessage()">
                Test Backend
            </button>

            <p id="result"></p>

        </section>


        <!-- About Section -->
        <section id="about">

            <h2>About</h2>

            <p>
                This is a simple full-stack website made using
                HTML, CSS, JavaScript, Python Flask and SQLite.
            </p>

        </section>


        <!-- Add User Section -->
        <section>

            <h2>Add User</h2>

            <form onsubmit="addUser(); return false;">

                <label>Name:</label>
                <br>

                <input
                    type="text"
                    id="name"
                    placeholder="Enter your name"
                    required
                >

                <br><br>

                <label>Email:</label>
                <br>

                <input
                    type="email"
                    id="email"
                    placeholder="Enter your email"
                    required
                >

                <br><br>

                <button type="submit">
                    Add User
                </button>

            </form>

            <p id="userResult"></p>

        </section>


        <!-- Users Section -->
        <section id="users">

            <h2>Users</h2>

            <button onclick="getUsers()">
                Show All Users
            </button>

            <div id="usersList"></div>

        </section>

    </main>


    <!-- Footer -->
    <footer>

        <p>© 2026 My Website</p>

    </footer>


    <!-- JavaScript -->
    <script src="/static/script.js"></script>

</body>

</html>
```
